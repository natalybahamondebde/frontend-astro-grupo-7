---

import TitleComponent from "./titleComponent.astro";
import SubtitleComponent from "./subtitleComponent.astro";
import SquareImageComponent from "./squareImageComponent.astro";
import LinkComponent from "./linkComponent.astro";

interface Props {
    image: string;
    date: string;
    title: string;
    description: string;
    link: string;
    button: string;
}
const { date = "default_date", title = "default_title", description = "default_desc", button, link } = Astro.props;
---


    <div class="h-100">
        <SquareImageComponent />
    </div>
    <div class="mx-10 flex flex-col justify-center gap-y-5">
        <SubtitleComponent text={date}
                           color="text-gris"
                           align="left" />
        <TitleComponent text={title}
                        color="secondary"
                        size="big" />
        <SubtitleComponent text={description}
                           color="text-gris"
                           align="left" />
        <LinkComponent link={link}>
            <SubtitleComponent text={button} color="text-button" align="right" />
        </LinkComponent>
    </div>