---

import TitleComponent from "./titleComponent.astro";
import RectangleImageComponent from "./rectangleImageComponent.astro";
import SubtitleComponent from "./subtitleComponent.astro";
import PrimaryButtonComponent from "./primaryButtonComponent.astro";
import LinkComponent from "./linkComponent.astro";

interface Props {
    image: string;
    date: string;
    title: string;
    description: string;
    link: string;
    button: string;
}
const { date = "default_date", title = "default_title", description = "default_desc", button, link } = Astro.props;
---

<div class="gap-y-5">
    <RectangleImageComponent />
    <SubtitleComponent text={date}
                       color="text-gris"
                       size="small"/>
    <TitleComponent text={title}
                    color="secondary"
                    size="small" />
    <SubtitleComponent text={description.slice(0,90)}
                       color="text-gris"
                       size="small" />
    <LinkComponent link={link}>
        <SubtitleComponent text={button} color="text-button" align="right" />
    </LinkComponent>
</div>