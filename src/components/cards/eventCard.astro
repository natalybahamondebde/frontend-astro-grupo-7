---
import TitleComponent from "../misc/titleComponent.astro";
import PrimaryButtonComponent from "../misc/primaryButtonComponent.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../../lib/conection";
import IconComponent from "../misc/iconComponent.astro";
import SubtitleComponent from "../misc/subtitleComponent.astro";
import {Image} from "astro:assets";

const { title, image, button, link } = Astro.props;
const iconos = await fetchFromAPI('iconos');

---

<div class="relative h-150 rounded-xl overflow-hidden hover:scale-105 transition-all duration-300">
    <Image src={image} inferSize={true}
            alt="img"
            class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

    <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 pb-10 gap-4">
        <div class="grid grid-cols-3 justify-items-center gap-2">
            {iconos.map((item) => (
                    <div class="flex flex-col gap-2 items-center text-center">
                        <IconComponent icono={`${STRAPI_BASE_URL}${item.icono.url}`} />
                        <SubtitleComponent color="primary" text={item.nombre} size="small" />
                    </div>
            ))}
        </div>

        <div class="flex flex-col items-center gap-4">
            <TitleComponent text={title} color="primary" />
            <a href={link}><PrimaryButtonComponent text={button} color="primary" /></a>
        </div>
    </div>
</div>