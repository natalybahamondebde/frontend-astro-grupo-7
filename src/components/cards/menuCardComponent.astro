---
import {Image} from "astro:assets";
interface Props {
    category: string;
    title: string;
    description: string;
    price: string;
}
const { category = "default_cat", image, title = "default_title", description = "default_desc", price = "default_price" } = Astro.props;
---

<div class="bg-white grid grid-cols-[30%_70%] gap-2 lg:gap-0 p-2 hover:scale-105 relative overflow-hidden shadow-lg shadow-text-gris hover:shadow-gray-500 transition-all duration-300s">
    <Image src={image} inferSize={true} class="bg-gray-500 h-35 w-40 aspect-square object-cover" alt=""></Image>
    <div class="flex flex-col justify-center">
        <p class="text-orange-400">{category}</p>
        <p class="font-bold">{title}</p>
        <p class="text-text-gris">{description}</p>
        <p class="font-bold text-button">{price}</p>
    </div>
</div>