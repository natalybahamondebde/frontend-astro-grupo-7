---

import SubtitleComponent from "../misc/subtitleComponent.astro";

interface Props {
    image: string;
    title: string;
    description: string;
}
const { image, title = "default_title", description = "default_desc" } = Astro.props;
---

<div class="flex flex-col lg:flex-row w-screen lg:w-full lg:h-40 p-10 lg:p-5 hover:scale-105 transition-all duration-300 gap-5 shadow-lg shadow-text-gris bg-white my-1">
    <div class="rounded-full flex flex-col bg-gray-300 w-40 lg:w-25 h-40 lg:h-25 items-center justify-center aspect-square relative">
        <img src={image} class="object-cover h-full w-full rounded-full" alt="alt"/>
    </div>
    <div class="flex flex-col justify-center">
        <div class="font-bold">{title}</div>
        <SubtitleComponent text={description}
                           align="left"
                           color="text-gris" />
    </div>
</div>