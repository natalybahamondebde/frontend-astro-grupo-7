---
import {fetchFromAPI, STRAPI_BASE_URL} from "../../lib/conection";
import BannerComponent from "../misc/bannerComponent.astro";
import TitleComponent from "../misc/titleComponent.astro";
import SubtitleComponent from "../misc/subtitleComponent.astro";
import PrimaryButtonComponent from "../misc/primaryButtonComponent.astro";
const data = await fetchFromAPI('about');
---

<BannerComponent image={`${STRAPI_BASE_URL}${data.banner.url}`}>
    <div class="w-[50%] py-5">
        <SubtitleComponent text={data.smallTitle}
                           color="primary"
                           align="center"/>
    </div>
    <div class="w-[70%] mb-20">
        <TitleComponent text={data.title}
                        color="primary"
                        size="big"
                        align="center" />
    </div>
    <div class="flex gap-5 flex-row">
        <a href={data.url4}><PrimaryButtonComponent text={data.button}
                                                    color="secondary" /></a>
    </div>
</BannerComponent>