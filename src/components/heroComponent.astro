---
import SubtitleComponent from "./subtitleComponent.astro";
import TitleComponent from "./titleComponent.astro";
import BannerComponent from "./bannerComponent.astro";
import PrimaryButtonComponent from "./primaryButtonComponent.astro";
import {fetchFromAPI} from "../lib/conection";
const data = await fetchFromAPI('home');
---

<BannerComponent image="">
    <div class="w-[70%]">
        <TitleComponent text={data.title}
                        color="primary"
                        size="big"
                        align="center" />
    </div>
    <div class="w-[50%] py-10">
        <SubtitleComponent text={data.subtitle}
                           color="primary"
                           align="center"/>
    </div>
    <div class="flex gap-5 flex-row">
        <PrimaryButtonComponent text={data.button_1}
                                color="primary" />
        <PrimaryButtonComponent text={data.name}
                                color="secondary" />
    </div>
</BannerComponent>