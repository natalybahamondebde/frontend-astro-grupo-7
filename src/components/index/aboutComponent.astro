---

import SquareImageComponent from "../misc/squareImageComponent.astro";
import SubtitleComponent from "../misc/subtitleComponent.astro";
import TitleComponent from "../misc/titleComponent.astro";
import SmallTitleComponent from "../misc/smallTitleComponent.astro";
import PrimaryButtonComponent from "../misc/primaryButtonComponent.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../../lib/conection";
const data = await fetchFromAPI('home');
---

<div class="grid grid-cols-[30%_70%] my-20">
    <div class="aspect-square">
        <SquareImageComponent image={`${STRAPI_BASE_URL}${data.image2.url}`} />
    </div>
    <div class="mx-10 justify-center flex flex-col gap-y-5">
        <SmallTitleComponent text={data.smallTitle_nosotros} />
        <TitleComponent text={data.title_nosotros}
                        color="secondary"
                        size="big" />
        <SubtitleComponent text={data.info_title}
                           color="text-gris"
                           align="left" />
        <a href={data.url2}><PrimaryButtonComponent text={data.boton2}
                                color="primary" /></a>
    </div>
</div>