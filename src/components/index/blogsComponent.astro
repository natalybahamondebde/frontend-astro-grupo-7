---

import SubtitleComponent from "../misc/subtitleComponent.astro";
import TitleComponent from "../misc/titleComponent.astro";
import SmallTitleComponent from "../misc/smallTitleComponent.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../../lib/conection";
import BlogsSmallComponent from "../cards/blogsSmallComponent.astro";
import BlogsBigComponent from "../cards/blogsBigComponent.astro";

interface TarjetasInterface {
    documentId: string;
    title: string;
    smalTitle: string;
    info: string;
    name: string;
    url: string;
}

const data = await fetchFromAPI('home');
const blogs: TarjetasInterface[] = (await fetchFromAPI('blogs')) || [];

const bigData = blogs[0];
const smallData = blogs.slice(1, 4);
---

<div class="my-10">
<div class="items-center flex flex-col gap-y-5">
    <SmallTitleComponent text={data.smallTitle_blog} />
    <TitleComponent text={data.title_blog} color="secondary" align="center" size="big" />
    <SubtitleComponent text={data.info_blog}
                       color="text-gris"
                       align="center" />
</div>
<div class="grid grid-cols-1 lg:grid-cols-[35%_65%] my-10">
<BlogsBigComponent
        date={bigData.smalTitle}
        image={`${STRAPI_BASE_URL}${bigData.image.url}`}
        title={bigData.title}
        description={bigData.info}
        button={bigData.name}
        link=`/blogs/${bigData.documentId}`
/>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 mt-10 mb-20 gap-10">
    {smallData.map((item) => (
            <BlogsSmallComponent
                    date={item.smalTitle}
                    image={`${STRAPI_BASE_URL}${item.image.url}`}
                    title={item.title}
                    description={item.info}
                    button={item.name}
                    link=`/blogs/${item.documentId}`
            />
    ))}
</div>
</div>