---

import SubtitleComponent from "../misc/subtitleComponent.astro";
import TitleComponent from "../misc/titleComponent.astro";
import {fetchFromAPI} from "../../lib/conection";
const data = await fetchFromAPI('home');
---

<div class="items-center justify-center gap-y-10 flex flex-col mt-10 h-150">
    <TitleComponent text={data.title_resenas}
                    align="center"
                    color="secondary"
                    size="big" />
    <div class="mx-50">
        <SubtitleComponent text={data.info_resenas}
                           align="center"
                           color="text-gris" />
    </div>
    <div class="grid grid-cols-3 w-90 h-40 gap-5">
        <div class="">
            <div class="rounded-full bg-gray-300 aspect-square"></div>
            <div class="text-center">Michella K.</div>
        </div>
        <div class="">
            <div class="rounded-full bg-gray-300 aspect-square"></div>
            <div class="text-center">Jessica W.</div>
        </div>
        <div class="">
            <div class="rounded-full bg-gray-300 aspect-square"></div>
            <div class="text-center">Aliffia A.</div>
        </div>
    </div>
</div>