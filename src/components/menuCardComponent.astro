---
interface Props {
    category: string;
    title: string;
    description: string;
    price: string;
    image: string;
}
const { category = "default_cat", image, title = "default_title", description = "default_desc", price = "default_price" } = Astro.props;
---

<div class="bg-white grid grid-cols-[30%_70%] p-2">
    <img src={image} class="bg-gray-500 h-35 aspect-square" alt="">
    <div class="flex flex-col justify-center">
        <p class="text-orange-400">{category}</p>
        <p class="font-bold">{title}</p>
        <p>{description}</p>
        <p class="font-bold text-button">{price}</p>
    </div>
</div>