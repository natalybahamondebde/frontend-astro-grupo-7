---
import TitleComponent from "./titleComponent.astro";
import SmallTitleComponent from "./smallTitleComponent.astro";
import PrimaryButtonComponent from "./primaryButtonComponent.astro";
import MenuSmallComponent from "./menuSmallComponent.astro";
import {fetchFromAPI} from "../lib/conection";
import MenuBigComponent from "./menuBigComponent.astro";
const data = await fetchFromAPI('home');

interface TarjetasInterface {
    documentId: string;
    title_tarjeta: string;
    smalTitle_tarjeta: string;
    info_tarjeta: string;
}

const tarjetas: TarjetasInterface[] = (await fetchFromAPI('tarjetas')) || [];

const bigData = tarjetas[0];
const smallData = tarjetas.slice(1, 4);
---

<div class="mx-40 mt-10 h-200">
    <div class="flex flex-col items-center">
        <SmallTitleComponent text={data.smallTitle_especial} />
        <TitleComponent text={data.title_especial}
                        color="secondary"
                        size="big"
                        align="center" />
    </div>
    <div class="grid grid-cols-[45%_55%]">
        <!-- BIG CARD -->
        <a href={`/tarjetas/${bigData.documentId}`}>
        <MenuBigComponent
                image={bigData.imagen || "default.jpg"}
                category={bigData.smalTitle_tarjeta}
                title={bigData.title_tarjeta}
                description={bigData.info_tarjeta}
        />
        </a>
        <!-- SMALL CARDS -->
        <div class="grid grid-rows-3">
            {smallData.map((item) => (
                    <a href={`/tarjetas/${item.documentId}`}>
                    <MenuSmallComponent
                            image={item.image_tarjeta || "default.jpg"}
                            category={item.smalTitle_tarjeta}
                            title={item.title_tarjeta}
                            description={item.info_tarjeta}
                    /></a>
            ))}
        </div>
</div>
</div>
<!-- BUTTON -->
<div class="items-center flex flex-col justify-center">
    <a href={data.url3}><PrimaryButtonComponent text={data.boton3} color="primary"/></a>
</div>