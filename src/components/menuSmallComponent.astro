---
import SquareImageComponent from "./squareImageComponent.astro";
import SubtitleComponent from "./subtitleComponent.astro";
interface Props {
    image: string;
    category: string;
    title: string;
    description: string;
}
const { image = "image.jpg", category = "default_cat", title = "default_title", description = "default_desc" } = Astro.props;
---

<div class="grid grid-cols-[25%_75%] p-5 h-50">
    <SquareImageComponent image={image} />
    <div class="m-5">
        <div class="bg-secondary w-20 py-1 text-center text-[12px] font-bold font-body">
            <p class="text-button">{category}</p>
        </div>
        <SubtitleComponent bold="bold" text={title} />
        <SubtitleComponent color="text-gris" text={description} />
    </div>
</div>