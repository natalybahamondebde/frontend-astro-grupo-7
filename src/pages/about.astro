---
import SubtitleComponent from "../components/misc/subtitleComponent.astro";
import TitleComponent from "../components/misc/titleComponent.astro";
import BannerComponent from "../components/bannerComponent.astro";
import Layout from "../layouts/Layout.astro";
import PrimaryButtonComponent from "../components/misc/primaryButtonComponent.astro";
import SquareImageComponent from "../components/misc/squareImageComponent.astro";
import SmallTitleComponent from "../components/misc/smallTitleComponent.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../lib/conection";
import RatingCard from "../components/ratingCard.astro";
import ChefBigComponent from "../components/chefBigComponent.astro";
import ChefSmallComponent from "../components/chefSmallComponent.astro";
const data = await fetchFromAPI('about');
---

<Layout>
    <!-- SECTION 0: B A N N E R -->
    <BannerComponent image={`${STRAPI_BASE_URL}${data.banner.url}`}>
        <div class="w-[50%] py-5">
            <SubtitleComponent text={data.smallTitle}
                               color="primary"
                               align="center"/>
        </div>
        <div class="w-[70%] mb-20">
            <TitleComponent text={data.title}
                            color="primary"
                            size="big"
                            align="center" />
        </div>
        <div class="flex gap-5 flex-row">
            <a href={data.url4}><PrimaryButtonComponent text={data.button}
                                    color="secondary" /></a>
        </div>
    </BannerComponent>
    <!-- SECTION 1: S Q U A R E S-->
    <div class="grid grid-cols-3 h-50 gap-15 mx-40 relative bottom-10 bg-white z-20">
        <RatingCard />
    </div>
    <!-- SECTION 2: H I S T O R Y-->
    <div class="grid grid-cols-[30%_70%] mx-40 my-20">
        <div class="relative object-cover">
            <SquareImageComponent image={`${STRAPI_BASE_URL}${data.banner4.url}`} />
        </div>
        <div class="mx-10 grid grid-row gap-y-5">
            <SmallTitleComponent text={data.smalTitle4} />
            <TitleComponent text={data.title4}
                            color="secondary"
                            size="big" />
            <SubtitleComponent text={data.info4.slice(0,262)}
                               color="text-gris"
                               align="left" />
            <a href={data.url4}><PrimaryButtonComponent text={data.button4}
                                    color="primary" /></a>
        </div>
    </div>

    <div class="grid grid-cols-[55%_45%] mx-40 my-20 gap-y-5">
        <div class="mx-10 grid grid-row">
            <SmallTitleComponent text={data.smalTitle5} />
            <TitleComponent text={data.title5}
                            color="secondary"
                            size="big" />
            <SubtitleComponent text={data.info5}
                               color="text-gris"
                               align="left" />
            <div class="grid grid-cols-3 h-50">
                <RatingCard />
            </div>
            <a href={data.url5}><PrimaryButtonComponent text={data.button5}
                                    color="primary" />
            </a>
        </div>
        <div class="relative object-cover">
            <SquareImageComponent image={`${STRAPI_BASE_URL}${data.banner5.url}`} />
        </div>
    </div>
    <div class="flex flex-col items-center gap-y-5 my-10">
        <SmallTitleComponent text={data.smallTitle2} />
        <TitleComponent text={data.title2}
                        color="secondary"
                        size="big"
                        align="center" />
        <SubtitleComponent text={data.info2}
                           color="text-gris"
                           align="center" />
    </div>
    <ChefBigComponent />
    <ChefSmallComponent />
    <div class="flex items-center flex-col my-5 pb-30">
        <a href={data.url6}>
        <PrimaryButtonComponent text={data.button6} color="primary" />
        </a>
    </div>
</Layout>