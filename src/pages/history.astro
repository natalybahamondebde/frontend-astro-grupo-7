---
import {fetchFromAPI, STRAPI_BASE_URL} from "../lib/conection";
import Layout from "../layouts/Layout.astro";
import TitleComponent from "../components/misc/titleComponent.astro";
import SmallTitleComponent from "../components/misc/smallTitleComponent.astro";
import SubtitleComponent from "../components/misc/subtitleComponent.astro";
import SquareImageComponent from "../components/misc/squareImageComponent.astro";
import PrimaryButtonComponent from "../components/misc/primaryButtonComponent.astro";
import BannerComponent from "../components/bannerComponent.astro";
const data = await fetchFromAPI('about');
---

<Layout>
    <BannerComponent image={`${STRAPI_BASE_URL}${data.banner4.url}`}>
        <div class="mx-10 grid grid-row gap-y-5">
            <TitleComponent text={data.title4}
                            color="primary"
                            size="big" align="center" />
        </div>
    </BannerComponent>
    <div class="mx-50 my-20 items-center flex flex-col gap-y-5 text-sm/8">
        <SmallTitleComponent text={data.smalTitle4} />
        <SubtitleComponent text={data.info4}
                           color="text-gris"
                           align="left" />
    </div>
</Layout>