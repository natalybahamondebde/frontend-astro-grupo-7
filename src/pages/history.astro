---
import {fetchFromAPI, STRAPI_BASE_URL} from "../lib/conection";
import Layout from "../layouts/Layout.astro";
import SmallTitleComponent from "../components/misc/smallTitleComponent.astro";
import SubtitleComponent from "../components/misc/subtitleComponent.astro";
import HeroHistoryComponent from "../components/hero/heroHistoryComponent.astro";
const data = await fetchFromAPI('about');
---

<Layout>
    <HeroHistoryComponent />
    <div class="mx-50 my-20 items-center flex flex-col gap-y-5 text-sm/8">
        <SmallTitleComponent text={data.smalTitle4} />
        <SubtitleComponent text={data.info4}
                           color="text-gris"
                           align="left" />
    </div>
</Layout>