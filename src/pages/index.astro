---
import Layout from '../layouts/Layout.astro';
import ReviewsComponent from "../components/index/reviewsComponent.astro";
import BlogsComponent from "../components/index/blogsComponent.astro";
import ServicesComponent from "../components/index/servicesComponent.astro";
import MenuMainComponent from "../components/index/menuMainComponent.astro";
import AboutComponent from "../components/index/aboutComponent.astro";
import HeroComponent from "../components/hero/heroComponent.astro";
---

<Layout>
    <!-- SECTION 0: B A N N E R -->
    <HeroComponent />
    <div class="mx-10 lg:mx-40">
    <!-- SECTION 1: A B O U T  U S -->
    <AboutComponent />
    <!-- SECTION 2 : M E N U -->
    <MenuMainComponent />
    <!-- SECTION 3 : S E R V I C E S -->
    <ServicesComponent />
    <!-- SECTION 4 : R E V I E W S -->
    <ReviewsComponent />
    <!-- SECTION 5 : B L O G S -->
    <BlogsComponent />
    </div>
</Layout>
