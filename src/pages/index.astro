---
import Layout from '../layouts/Layout.astro';
import HeaderComponent from "../components/headerComponent.astro";
import BannerComponent from "../components/bannerComponent.astro";
import TitleComponent from "../components/titleComponent.astro";
import {fetchFromAPI, STRAPI_BASE_URL, STRAPI_URL} from "../lib/conection";
const data = await fetchFromAPI('home');
---

<Layout>
    <HeaderComponent />
    <BannerComponent>
        {data.title}
    </BannerComponent>
    <TitleComponent />
</Layout>
