---

import SquareImageComponent from "../components/squareImageComponent.astro";
import SubtitleComponent from "../components/subtitleComponent.astro";
import TitleComponent from "../components/titleComponent.astro";
import PrimaryButtonComponent from "../components/primaryButtonComponent.astro";
import Layout from "../layouts/Layout.astro";
import SmallTitleComponent from "../components/smallTitleComponent.astro";
import MenuCardComponent from "../components/menuCardComponent.astro";
import {fetchFromAPI} from "../lib/conection";

interface TarjetasInterface {
    documentId: string;
    smalTitle: string;
    title: string;
    info: string;
    price: string;
}

const data = await fetchFromAPI('home');
const tarjetas: TarjetasInterface[] = (await fetchFromAPI('tarjetas')) || [];
---

<Layout>
    <div class="bg-secondary relative w-full h-screen">
        <div class="absolute inset-0 flex flex-col items-center justify-center z-10">
            <div class="grid grid-cols-[40%_60%] h-full mx-20">
                <div class="mx-10 justify-center flex flex-col">
                    <SmallTitleComponent text="MENU" />
                    <TitleComponent text="Our Menu"
                                    color="secondary"
                                    size="big" />
                    <SubtitleComponent text="The food at Dinely Restaurant best describes it self in one word diversity. Foodies will have no shortage of options, from the nutritious breakfast menu offered by Kakao to afternoon coffee and delectable fare."
                                       color="secondary"
                                       align="left" />
                    <PrimaryButtonComponent text="SEE ALL MENU"
                                            color="primary" />
                </div>
                <div>
                    <SquareImageComponent />
                </div>
            </div>
        </div>
    </div>
    <div class="mx-50 my-10">
        <TitleComponent text="Read Our Delicious Menu"
                        color="secondary"
                        size="big"
                        align="center" />
        <SubtitleComponent text="We've meticulously created each flavor on our menu to entice your palate and leave you wanting more. Each meal is a work of art, combining the love of our talented chefs with the freshest ingredients."
                           color="secondary"
                           align="center" />
    </div>
    <ul class="flex flex-row items-center justify-center gap-15">
        <li class="bg-button py-3 px-15 text-white font-bold">All</li>
        <li>Desserts</li>
        <li>Drinks</li>
        <li>Main</li>
        <li>Breakfast</li>
    </ul>
    <div class="grid grid-cols-2 mx-40 my-10 gap-10">
        {tarjetas.map((item) => (
                <a href={`/tarjetas/${item.documentId}`}>
                <MenuCardComponent
                        category={item.smalTitle_tarjeta}
                        title={item.title_tarjeta}
                        description={item.info_tarjeta}
                        price={item.precio}
                />
                </a>
        ))}
    </div>
</Layout>