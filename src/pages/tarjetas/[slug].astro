---
import Layout from "../../layouts/Layout.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../../lib/conection";
import TitleComponent from "../../components/misc/titleComponent.astro";
import SubtitleComponent from "../../components/misc/subtitleComponent.astro";
import SmallTitleComponent from "../../components/misc/smallTitleComponent.astro";
import SquareImageComponent from "../../components/misc/squareImageComponent.astro";

interface TarjetasSingle {
    documentId: string;
    title_tarjeta: string;
    info_tarjeta: string;
}

export async function getStaticPaths(){
    const tarjetas = await fetchFromAPI("tarjetas");

    return tarjetas.map ((tarjeta: TarjetasSingle) => ({
        params: {
            slug: tarjeta.documentId
        },
        props: {
            tarjeta: tarjeta
        }
    }))
}

const { tarjeta }: {tarjeta: TarjetasSingle} = Astro.props;
---
<Layout>
    <div class="h-20"></div>
    <div class="mx-50 grid grid-cols-[50%_50%] my-20">
        <div class="h-90 w-90">
            <SquareImageComponent image={`${STRAPI_BASE_URL}${tarjeta.image.url}`} />
        </div>
        <div class="flex flex-col gap-y-5">
            <SmallTitleComponent text={tarjeta.tipos?.[0]?.tipo ?? 'General'} />
            <TitleComponent size="big" text={tarjeta.title_tarjeta} />
            <SubtitleComponent color="text-gris" text={tarjeta.info_tarjeta} />
            <TitleComponent text={tarjeta.precio} />
        </div>
    </div>
</Layout>