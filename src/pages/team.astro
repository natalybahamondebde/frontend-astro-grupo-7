---
import TitleComponent from "../components/misc/titleComponent.astro";
import SubTitleComponent from "../components/misc/subtitleComponent.astro";
import Layout from "../layouts/Layout.astro";
import {fetchFromAPI, STRAPI_BASE_URL} from "../lib/conection";
import SquareImageComponent from "../components/misc/squareImageComponent.astro";
import HeroTeamComponent from "../components/hero/heroTeamComponent.astro";

const data = await fetchFromAPI('equipo');
const equipo = await fetchFromAPI('tarjeta-equipos');
const chefs = equipo.slice(3,12)
const staff = equipo.slice(0,3)
---

<Layout>
    <div class="h-20"></div>
    <HeroTeamComponent />
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-5 relative mx-10 lg:mx-50 bottom-0 lg:bottom-40 z-30">
        {staff.map((item) => (
                <div class="bg-white flex flex-col items-center p-5">
                    <div class="h-50 md:h-80 lg:h-80 w-full object-cover relative">
                        <SquareImageComponent image={`${STRAPI_BASE_URL}${item.image.url}`} />
                    </div>
                    <div class="flex flex-col gap-y-5 my-5 text-center items-center">
                        <TitleComponent color="secondary" size="small" text={item.nombre} />
                        <SubTitleComponent color="secondary" bold="bold" text={item.cargo} />
                    </div>
                </div>
        ))}
    </div>
    <div class="mx-10 lg:mx-50">
    <div class="flex flex-col gap-y-5 mb-20">
    <TitleComponent text={data.title2} color="secondary" align="center" size="big"/>
    <SubTitleComponent text={data.info2}
                       color="text-gris"
                       align="center"/>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-5 my-20">
        {chefs.map((item) => (
        <div class="bg-white flex flex-col items-center p-5">
            <div class="h-50 md:h-80 lg:h-80 w-full object-cover relative">
            <SquareImageComponent image={`${STRAPI_BASE_URL}${item.image.url}`} />
            </div>
            <div class="flex flex-col gap-y-5 my-5 text-center items-center">
            <TitleComponent color="secondary" size="small" text={item.nombre} />
            <SubTitleComponent color="secondary" bold="bold" text={item.cargo} />
            </div>
        </div>
        ))}
    </div>
    </div>
</Layout>